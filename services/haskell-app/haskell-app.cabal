cabal-version:      2.4
name:               haskell-app
version:            0.1.0
build-type:         Simple

executable haskell-app
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , bytestring
                    , http-types
                    , wai
                    , warp
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts
