cabal-version:      2.4
name:               haskell-scotty
version:            0.1.0
build-type:         Simple

executable haskell-scotty
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , scotty
                    , text
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts
